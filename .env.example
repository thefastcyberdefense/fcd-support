# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_WEBHOOK_BASE_URL=

# PostgreSQL
DATABASE_URL=
POSTGRES_DB=fcd_support
POSTGRES_USER=fcd_support
POSTGRES_PASSWORD=

# Manifest Harness: fcd-support
MANIFEST_BASE_URL=http://manifest:2099/v1
MANIFEST_API_KEY=
MANIFEST_MODEL=auto

# Meta application
META_GRAPH_API_VERSION=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Internal escalation
N8N_ESCALATION_WEBHOOK_URL=
N8N_ESCALATION_WEBHOOK_SECRET=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Data policy
CASUAL_CHAT_RETENTION_DAYS=60
UNCONVERTED_LEAD_RETENTION_DAYS=365
HUMAN_PAUSE_HOURS=24
STALE_EVENT_MAX_MINUTES=5
MARKETING_BLANK_IS_OPT_IN=false
AUTOMATIC_KNOWLEDGE_CRAWL=false

# Backup encryption
BACKUP_ENCRYPTION_PASSWORD=
