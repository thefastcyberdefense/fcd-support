# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
PUBLIC_WEBHOOK_BASE_URL=

# PostgreSQL
DATABASE_URL=
DATABASE_URL_FILE=
POSTGRES_DB=fcd_support
POSTGRES_USER=fcd_support
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_FILE=
PRIVACY_HMAC_KEYRING_FILE=

# Private administration (separate process; never attach to webhook ingress)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3004
ADMIN_ORIGIN=http://127.0.0.1:3004
ADMIN_SECURE_COOKIE=false
ADMIN_SESSION_HMAC_KEY=
ADMIN_MFA_ENCRYPTION_KEY=
ADMIN_SESSION_HMAC_KEY_FILE=
ADMIN_MFA_ENCRYPTION_KEY_FILE=
ADMIN_MFA_KEY_VERSION=local-v1
ADMIN_PASSWORD_COST=65536
ADMIN_PASSWORD_BLOCK_SIZE=8
ADMIN_PASSWORD_PARALLELIZATION=1
ADMIN_PASSWORD_KEY_LENGTH=32
ADMIN_PASSWORD_SALT_LENGTH=32
ADMIN_PREAUTH_TTL_MS=300000
ADMIN_SESSION_TTL_MS=28800000
ADMIN_TOTP_DIGITS=6
ADMIN_TOTP_PERIOD_SECONDS=30
ADMIN_TOTP_VERIFICATION_WINDOW=1
ADMIN_ACTION_TTL_MS=900000
ADMIN_LIST_LIMIT=100

# Proposal-only learning (bounded and operator configurable)
LEARNING_MINIMUM_GROUP_COUNT=3
LEARNING_DIGEST_INTERVAL_MS=259200000
LEARNING_MAX_QUESTIONS_PER_DIGEST=5
LEARNING_QUESTION_COOLDOWN_MS=604800000
LEARNING_MAX_DIGEST_APPEARANCES=2
LEARNING_MAX_OBSERVATIONS_PER_RUN=1000

# Manifest Harness: fcd-support
MANIFEST_BASE_URL=http://manifest:2099/v1
MANIFEST_API_KEY=
MANIFEST_API_KEY_FILE=
MANIFEST_MODEL=auto
# Fail closed until each non-secret operational fact is separately verified.
MANIFEST_RECORDING_DISABLED=false
MANIFEST_DELETION_RETENTION_APPROVED=false
MANIFEST_PROVIDER_ALLOWLIST_APPROVED=false
MANIFEST_LIMITS_WITHIN_DEPLOYMENT_CEILINGS=false
MANIFEST_PRIVATE_ROUTE_VERIFIED=false

# Protected model ceilings (operator-customizable; active policy may only be stricter)
MODEL_MAX_CALLS_PER_CONTACT_15_MINUTES=3
MODEL_MAX_CALLS_PER_CONTACT_24_HOURS=10
MODEL_MAX_CALLS_PER_UTC_DAY=300
MODEL_MAX_CONCURRENT_CALLS=4
MODEL_MAX_QUEUE_DEPTH=25
MODEL_TOTAL_TIMEOUT_MS=20000
MODEL_MAX_OUTPUT_TOKENS=600
MODEL_COOLDOWN_MS=300000
MODEL_APPROVED_PROVIDER_ATTEMPTS=3
MODEL_ARCHITECTURE_PROVIDER_CEILING=5
MODEL_MAX_RESPONSE_BYTES=65536
MODEL_MAX_CONTEXT_ITEMS=8
MODEL_MAX_INPUT_CODE_POINTS=4000

# Meta application
META_GRAPH_API_VERSION=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_MESSENGER_PAGE_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_VERIFY_TOKEN_FILE=
META_APP_SECRET_FILE=
META_PAGE_ACCESS_TOKEN_FILE=
META_MESSENGER_PAGE_ID_FILE=
META_WHATSAPP_ACCESS_TOKEN_FILE=
META_WHATSAPP_PHONE_NUMBER_ID_FILE=

# Outbound provider boundary (all values required; no enabling defaults)
OUTBOUND_META_BASE_URL=
OUTBOUND_ALLOW_LOOPBACK_FAKE=
OUTBOUND_MAX_PER_CONTACT_15_MINUTE=
OUTBOUND_MAX_PER_CONTACT_24_HOUR=
OUTBOUND_MAX_WHATSAPP_ACCOUNT_1_MINUTE=
OUTBOUND_MAX_MESSENGER_ACCOUNT_1_MINUTE=
OUTBOUND_MAX_GLOBAL_1_MINUTE=
OUTBOUND_MAX_GLOBAL_UTC_DAY=
OUTBOUND_MAX_WORKER_BATCH_SIZE=
OUTBOUND_MAX_LEASE_MS=
OUTBOUND_MAX_PROVIDER_TIMEOUT_MS=
OUTBOUND_MAX_DEFINITE_RETRIES=
OUTBOUND_MIN_RETRY_BASE_MS=
OUTBOUND_MIN_RETRY_MAXIMUM_MS=
OUTBOUND_MAX_RESPONSE_BYTES=

# Internal escalation
N8N_ESCALATION_WEBHOOK_URL=
N8N_ESCALATION_WEBHOOK_SECRET=
N8N_ESCALATION_WEBHOOK_SECRET_FILE=
N8N_PROVIDER_TIMEOUT_MS=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Data policy
CASUAL_CHAT_RETENTION_DAYS=60
UNCONVERTED_LEAD_RETENTION_MONTHS=12
HUMAN_PAUSE_HOURS=24
# Phase 0 must approve channel/event-specific stale handling before it becomes runtime configuration.
# Missing or blank marketing consent is always ineligible and is intentionally not configurable.
AUTOMATIC_KNOWLEDGE_CRAWL=false

# Phase 6 role runtime: external execution requires explicit enablement later.
# Production secrets use individual read-only *_FILE mounts; omit direct values.
# Never share a full secret-bearing environment across different roles.
MODEL_EXECUTION_ENABLED=false
OUTBOUND_EXECUTION_ENABLED=false
N8N_EXECUTION_ENABLED=false

# Required operator-configurable scheduling, lease, and shutdown bounds.
# OPS_STOP_GRACE_MS and OPS_LEASE_MS must exceed max call + shutdown grace.
OPS_POLL_MS=
OPS_BATCH_SIZE=
OPS_LEASE_MS=
OPS_MAX_CALL_MS=
OPS_SHUTDOWN_GRACE_MS=
OPS_STOP_GRACE_MS=
OPS_HEALTH_STALE_MS=
OPS_GIT_REVISION=
OPS_SCHEMA_REVISION=

# Reply role: stricter FAQ floors/caps and outbound ceilings; no provider credentials.
# Fuzzy FAQ thresholds still require active reviewed PostgreSQL policy.
REPLY_FAQ_POLICY_JSON=
REPLY_OUTBOUND_BOUNDS_JSON=
# Required only when model execution is explicitly enabled and approved.
REPLY_MANIFEST_ATTESTATION_JSON=
OPS_LEARNING_POLICY_JSON=
OPS_LEARNING_WINDOW_MS=

# Local is loopback-only; container_private still requires loopback host publication.
ADMIN_LISTEN_MODE=local
# ADMIN_SOCKET_PATH=/run/fcd-support-admin/admin.sock
# ADMIN_BROWSER_PORT=

# Verified host capacity and per-role resource maps; no enabling defaults.
# Resource fields: cpus, memoryMiB, pids, tmpfsMiB.
# OPS_RESOURCE_LIMITS_JSON maps role names to those four numeric fields.
# OPS_RESOURCE_BOUNDS_JSON contains minimum and maximum objects of those fields.
OPS_HOST_CPUS=
OPS_HOST_MEMORY_MIB=
OPS_RESOURCE_LIMITS_JSON=
OPS_RESOURCE_BOUNDS_JSON=

# Backup counts cannot be configured below the approved 45 daily / 6 monthly.
# Calendar expressions receive final systemd validation during host scheduling.
BACKUP_DAILY_RETENTION=
BACKUP_MONTHLY_RETENTION=
BACKUP_CALENDAR=
MAINTENANCE_CALENDAR=

# Public-recipient backup; private identity only in verification/restore jobs.
BACKUP_ENCRYPTION_RECIPIENT_FILE=
RECOVERY_MANIFEST_HMAC_FILE=
BACKUP_AGE_IDENTITY_FILE=
