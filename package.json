{
  "name": "fcd-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "admin:bootstrap": "npm run build --silent && node dist/admin/admin-bootstrap.js",
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run validate:phase0 && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --migrations-table pgmigrations --database-url-var DATABASE_URL",
    "db:migrate:down": "node-pg-migrate down --migrations-dir migrations --migrations-table pgmigrations --database-url-var DATABASE_URL",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "start:admin": "node dist/admin-main.js",
    "start:reply": "node dist/worker-main.js reply",
    "start:outbound": "node dist/worker-main.js outbound",
    "start:notification": "node dist/worker-main.js notification",
    "ops": "node dist/operations-main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:phase0": "node scripts/validate-phase0-gate.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.12"
  }
}
