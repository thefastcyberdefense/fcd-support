FROM cloudflare/cloudflared:2026.8.2@sha256:0aa26e284f05e6c77ae375b8c9c11d9eb6a448fb7bcd8d40f31cb6176189eb38

ARG VCS_REF
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.source="https://github.com/thefastcyberdefense/fcd-support"

USER 65532:65532

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["cloudflared", "tunnel", "--metrics", "127.0.0.1:2000", "ready"]

ENTRYPOINT ["cloudflared"]
