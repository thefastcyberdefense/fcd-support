FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS runtime

ARG VCS_REF
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.source="https://github.com/thefastcyberdefense/fcd-support"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      tesseract-ocr \
      tesseract-ocr-eng \
      tesseract-ocr-ben \
    && rm -rf /var/lib/apt/lists/* \
    && tesseract --version \
    && tesseract --list-langs | grep -qx 'eng' \
    && tesseract --list-langs | grep -qx 'ben'

ENV NODE_ENV=production \
    OCR_PORT=8091 \
    TMPDIR=/tmp

WORKDIR /app
COPY --chown=node:node src/media/ocr-server.ts ./ocr-server.ts

USER node
EXPOSE 8091
CMD ["node", "ocr-server.ts"]
