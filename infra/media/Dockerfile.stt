FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      cmake \
      ca-certificates \
      curl \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY infra/media/stt-toolchain.json /tmp/stt-toolchain.json
RUN node --input-type=module -e 'import { readFile, writeFile } from "node:fs/promises"; if (process.platform !== "linux" || process.arch !== "x64") throw new Error("unsupported_platform"); const t = JSON.parse(await readFile("/tmp/stt-toolchain.json", "utf8")); const src = await fetch(t.whisperCpp.sourceUrl, { signal: AbortSignal.timeout(120000) }); if (!src.ok) throw new Error("whisper_source_download_failed"); await writeFile("/tmp/whisper.tar.gz", Buffer.from(await src.arrayBuffer())); const mdl = await fetch(t.model.sourceUrl, { signal: AbortSignal.timeout(300000) }); if (!mdl.ok) throw new Error("whisper_model_download_failed"); await writeFile("/tmp/ggml-base.bin", Buffer.from(await mdl.arrayBuffer()));' \
    && node -e 'const t = require("/tmp/stt-toolchain.json"); console.log(t.whisperCpp.releaseSha256 + "  /tmp/whisper.tar.gz\n" + t.model.modelSha256 + "  /tmp/ggml-base.bin")' | sha256sum --check --status \
    && mkdir -p /tmp/whisper-src /opt/whisper \
    && tar -xzf /tmp/whisper.tar.gz --strip-components=1 -C /tmp/whisper-src \
    && cmake -S /tmp/whisper-src -B /tmp/whisper-build -DBUILD_SHARED_LIBS=OFF -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_EXAMPLES=ON \
    && cmake --build /tmp/whisper-build --target whisper-cli -j2 \
    && install -m 0755 /tmp/whisper-build/bin/whisper-cli /usr/local/bin/whisper-cli \
    && install -m 0644 /tmp/ggml-base.bin /opt/whisper/ggml-base.bin

FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS runtime

ARG VCS_REF
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.source="https://github.com/thefastcyberdefense/fcd-support"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ffmpeg \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && ffmpeg -version >/dev/null

COPY --from=build /usr/local/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=build --chown=node:node /opt/whisper/ggml-base.bin /opt/whisper/ggml-base.bin
COPY --from=build /tmp/stt-toolchain.json /usr/local/share/fcd-support/stt-toolchain.json
RUN whisper-cli --help >/dev/null

ENV NODE_ENV=production \
    STT_PORT=8092 \
    WHISPER_MODEL_PATH=/opt/whisper/ggml-base.bin \
    TMPDIR=/tmp

WORKDIR /app
COPY --chown=node:node src/media/stt-server.ts ./stt-server.ts

USER node
EXPOSE 8092
CMD ["node", "stt-server.ts"]
